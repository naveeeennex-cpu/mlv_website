# Copy this file to .env and replace the placeholder values.
# Required for database-backed features.
DATABASE_URL=postgresql://user:password@localhost:5432/mlv_db

# WhatsApp / Meta Business API
# Required for sending WhatsApp messages.
MLV_PHONE_ID=your_whatsapp_phone_number_id
MLV_WA_TOKEN=your_meta_access_token
MLV_OWNER_PHONE=919176186062

# Webhook verification token used by the WhatsApp webhook.
WHATSAPP_VERIFY_TOKEN=change-this-to-a-random-string

# Admin authentication secret.
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret

# Cron endpoint authorization.
CRON_SECRET=change-this-to-a-random-secret

# Gemini API keys for AI chat features.
# At least one of these is recommended for AI replies.
# Keys are tried in order: GEMINI_API_KEY, then _2.._5, then GEMINI_API_KEYS.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional numbered backup keys used for rate-limit/quota failover
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# Optional backup keys (comma-separated)
# GEMINI_API_KEYS=key1,key2

# Supabase credentials for image uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
